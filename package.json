{
  "name": "local-ledger",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, fully encrypted personal finance desktop app",
  "author": "Aaron Yang",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "start": "electron-vite preview",
    "build": "npm run compile && electron-builder --publish never",
    "build:dir": "npm run compile && electron-builder --dir --publish never",
    "lint": "oxlint && node scripts/check-sandbox-flags.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run compile && playwright test",
    "test:native": "npm run compile && electron . --self-test",
    "screenshots": "npm run compile && playwright test -c playwright.screens.config.ts",
    "test:package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/native/check-package.mjs",
    "seed": "vite build -c scripts/seed/vite.config.mts && node .demo/seed/seed.mjs",
    "demo": "electron-vite dev -- --user-data-dir=.demo/user-data",
    "csv:shape": "vite build -c scripts/csv-shape/vite.config.mts && node .demo/csv-shape/csv-shape.mjs"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "hash-wasm": "4.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  }
}
